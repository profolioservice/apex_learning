# Set only after a real public domain is connected; never use a Preview/internal URL.
NEXT_PUBLIC_SITE_URL=

# Optional enquiry persistence. SUPABASE_URL must be the HTTPS root of the institute's project.
# Add real values only after creating the service. Never expose the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional in-process IP rate limit. Set only to an ingress header the hosting provider
# overwrites with one canonical client IP and strips from visitor-supplied requests.
# Do not point this at a user-controlled X-Forwarded-For value.
TRUSTED_CLIENT_IP_HEADER=
